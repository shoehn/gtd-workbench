# Every setting the app reads, with a harmless default. Copy to .env (git-ignored) and adjust.
# Never put real secrets in this file — it is committed.

# Which store: memory (demo data, resets on restart) or sqlite. Default: sqlite in production.
STORE=sqlite
# The SQLite file (the container uses /data/gtd.db).
DATABASE_FILE=data/gtd.db
# Port the server listens on inside the container / process.
PORT=3000
# Time zone for "today", midnight and overdue, unless set on /settings.
TZ=Europe/Zurich
# error | warn | info | debug
LOG_LEVEL=info
# 1 = "today" is the demo's date (sat 26.09) — for screenshots; `pnpm dev:demo` sets it. Never in production.
# DEMO_DATE=1

# Read-only calendars: one group per calendar, <ID> in capitals (see docs/OPERATIONS.md).
# CAL_WORK_URL=https://calendar.example.com/published/work.ics
# CAL_HOME_URL=https://dav.example.com/calendars/me/home/
# CAL_HOME_USER=me
# CAL_HOME_PASS=
# CAL_HOME_NAME=Home
# CAL_HOME_KIND=caldav

# Capture endpoint POST /api/capture (see docs/OPERATIONS.md). Unset = off. Use a long random value.
# CAPTURE_TOKEN=

# Capture mailbox, polled every 2 min. Only senders in CAPTURE_MAIL_FROM capture; required.
# CAPTURE_MAIL_HOST=imap.example.com
# CAPTURE_MAIL_PORT=993
# CAPTURE_MAIL_TLS=true
# CAPTURE_MAIL_USER=inbox@example.com
# CAPTURE_MAIL_PASS=
# CAPTURE_MAIL_FROM=me@example.com
# CAPTURE_MAIL_FOLDER=INBOX
# CAPTURE_MAIL_PROCESSED=Processed

# Traefik in Docker (compose.traefik.yaml → compose.override.yaml on the server).
# GTD_HOST=gtd.example.com
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_HTTP_ENTRYPOINT=web
# TRAEFIK_CERTRESOLVER=letsencrypt
# TRAEFIK_AUTH_MIDDLEWARE=authelia@docker

# compose.yaml only
GTD_PORT=3000
BACKUP_KEEP=14
# Where db:backup writes (default: a "backups" folder next to DATABASE_FILE).
# BACKUP_DIR=data/backups

# pnpm smoke only
# SMOKE_PORT=3999
# CHROME_PATH=/path/to/chrome
